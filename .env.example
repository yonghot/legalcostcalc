# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Canonical site URL ───────────────────────────────────────────────────────
# Optional — defaults to https://legalcostcalc.co in code. Used at runtime to
# compute the canonical hostname that gates GA4 script injection (see
# NEXT_PUBLIC_GA_DEBUG below).
# NEXT_PUBLIC_APP_URL=https://legalcostcalc.co

# ─── Privacy-friendly analytics ──────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=legalcostcalc.com

# ─── Google Analytics 4 (gtag.js) ────────────────────────────────────────────
# Measurement ID from GA4 Admin > Data Streams (format: G-XXXXXXXXXX).
# NEXT_PUBLIC_GA_MEASUREMENT_ID is also accepted as an alias.
# NEXT_PUBLIC_GA_ID=
#
# GA4 only loads on the canonical production hostname (NEXT_PUBLIC_APP_URL,
# checked when NEXT_PUBLIC_VERCEL_ENV=production) — this keeps preview,
# localhost, and mirror-domain traffic out of GA4 reports entirely.
#
# OWNER ACTION REQUIRED: NEXT_PUBLIC_VERCEL_ENV is NOT auto-populated by
# Vercel — the built-in $VERCEL_ENV var is server-only. In Vercel Project
# Settings > Environment Variables, add NEXT_PUBLIC_VERCEL_ENV and set its
# value per-environment: "production" for the Production environment, and
# leave it unset (or a non-"production" value) for Preview/Development. Until
# this is set, GA4 will never load in production either — this is by design
# (fail closed, not fail open, on a misconfigured gate).
# NEXT_PUBLIC_VERCEL_ENV=
#
# Set to '1' ONLY on a Vercel Preview deployment env to re-enable GA on that
# deploy for DebugView verification. Preview traffic is tagged debug_mode
# + traffic_type:'internal' so it never reaches production reports. NEVER set
# this in the Production environment.
# NEXT_PUBLIC_GA_DEBUG=
#
# Per-site identifier stamped on every analytics event (site param). Falls
# back to a per-repo literal in code when unset.
# NEXT_PUBLIC_SITE_ID=legalcostcalc

# ─── Contact / Feedback ──────────────────────────────────────────────────────
# NEXT_PUBLIC_CONTACT_EMAIL=
# FEEDBACK_ENDPOINT=

# ─── IndexNow (Bing/Yandex/Naver — Google does not participate) ─────────────
# A 32-hex-char key you generate yourself (e.g. `openssl rand -hex 16`).
# When set: (1) "prebuild" writes public/{key}.txt for ownership verification;
# (2) "postbuild" POSTs the quality-gated sitemap URL list to IndexNow, but
# ONLY when VERCEL_ENV=production (Vercel's built-in var — no NEXT_PUBLIC_
# alias needed, this only runs server/build-side). Leave unset to disable
# both steps entirely (both are no-ops, never fail the build).
# INDEXNOW_KEY=

# ─── YMYL Reviewer Byline (K06) ───────────────────────────────────────────────
# Real, licensed-attorney reviewer identity shown in <AuthorByline> on every
# /[state]/[slug] page and mirrored into the Organization JSON-LD as a
# `reviewedBy` Person entry. Leave BOTH unset until a real reviewer is under
# contract (P04 in the ad-revenue spec) — the byline falls back to the honest
# "(legal reviewer pending)" placeholder copy. NEVER set a fabricated name or
# credential here.
# Example: NEXT_PUBLIC_REVIEWER_NAME=Jane Smith
#          NEXT_PUBLIC_REVIEWER_CREDENTIALS=Esq., California Bar #123456
NEXT_PUBLIC_REVIEWER_NAME=
NEXT_PUBLIC_REVIEWER_CREDENTIALS=

# ═══════════════════════════════════════════════════════════════════════════════
# MONETIZATION — all keys below are ENV-GATED.
# Render NULL when unset. Do NOT use placeholders as real values.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Programmatic Ad Network (exactly one loads at a time) ───────────────────
# Valid values: adsense | ezoic | raptive | journey | none   Default: adsense
# Controls which single network AdProvider loads. NEVER set two active at once.
NEXT_PUBLIC_AD_PROVIDER=

# ─── Google AdSense ──────────────────────────────────────────────────────────
# Set after your site is APPROVED in AdSense.
# Format: ca-pub-XXXXXXXXXXXXXXXX  Leave unset to disable ads entirely.
# When set: loads the AdSense script; enables /ads.txt publisher line.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ─── Ezoic ───────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_AD_PROVIDER=ezoic AND supply the script src from your Ezoic
# dashboard. Leave blank when using AdSense or Raptive.
# Example: NEXT_PUBLIC_EZOIC_ENABLED=true
#          NEXT_PUBLIC_EZOIC_SCRIPT_SRC=https://cid.ezoic.net/pub/your-site-id.js
NEXT_PUBLIC_EZOIC_ENABLED=
NEXT_PUBLIC_EZOIC_SCRIPT_SRC=

# ─── Raptive (formerly AdThrive) ─────────────────────────────────────────────
# Set NEXT_PUBLIC_AD_PROVIDER=raptive AND supply your Raptive site ID.
# Leave blank when using AdSense, Ezoic, or Journey.
# Example: NEXT_PUBLIC_RAPTIVE_SITE_ID=your-raptive-site-id
NEXT_PUBLIC_RAPTIVE_SITE_ID=

# ─── Journey by Mediavine (K10 — dormant, premium-tier upgrade) ──────────────
# DO NOT set until this site crosses ~1,000 real sessions/month (부속M §6
# eligibility threshold, verified 2026-01-15). Set NEXT_PUBLIC_AD_PROVIDER=
# journey AND supply your Journey site ID once approved for the program.
# Leave blank when using AdSense, Ezoic, or Raptive — renders nothing when
# unset, and never loads alongside another programmatic network (single-
# provider invariant enforced in AdProvider.tsx / tested in
# tests/monetization.test.ts).
# Example: NEXT_PUBLIC_JOURNEY_SITE_ID=your-journey-site-id
NEXT_PUBLIC_JOURNEY_SITE_ID=

# ─── ads.txt redirect ────────────────────────────────────────────────────────
# When set, /ads.txt issues a 301 redirect to this URL (Ezoic/Raptive ads.txt
# managers). The AdSense line is preserved in the default non-redirect path.
# Example: NEXT_PUBLIC_ADSTXT_REDIRECT_URL=https://cdn.ezoic.net/ads.txt
NEXT_PUBLIC_ADSTXT_REDIRECT_URL=

# ─── Primary Intent CTA ──────────────────────────────────────────────────────
# Valid values: call | cpl | affiliate | none   Project default: call
# call      => tel: button using NEXT_PUBLIC_PPC_NUMBER/_LABEL
# cpl       => outbound link to NEXT_PUBLIC_CPL_URL/_LABEL (advertiser-hosted)
# affiliate => featured affiliate button (first configured affiliate partner)
# none      => suppress the CTA block entirely
NEXT_PUBLIC_PRIMARY_CTA_TYPE=

# Pay-per-call — required when PRIMARY_CTA_TYPE=call
# Example: NEXT_PUBLIC_PPC_NUMBER=+18005551234
#          NEXT_PUBLIC_PPC_LABEL=Call a Legal Professional Now
NEXT_PUBLIC_PPC_NUMBER=
NEXT_PUBLIC_PPC_LABEL=

# Cost-per-lead — required when PRIMARY_CTA_TYPE=cpl
# Outbound link to an advertiser-hosted form (TCPA liability = 0 for this site).
# Example: NEXT_PUBLIC_CPL_URL=https://tracking.partner.com/legal-form
#          NEXT_PUBLIC_CPL_LABEL=Get a Free Case Evaluation
NEXT_PUBLIC_CPL_URL=
NEXT_PUBLIC_CPL_LABEL=

# ─── Featured Partner Table ───────────────────────────────────────────────────
# JSON array of {label, figure, href} objects (3–5 rows). When unset or invalid
# JSON, both the FTC disclosure line and the table are hidden entirely.
# Example:
#   MON_FEATURED_PARTNERS=[{"label":"LegalZoom","figure":"From $79","href":"https://tracking.example.com/lz"},{"label":"Rocket Lawyer","figure":"From $39.99/mo","href":"https://tracking.example.com/rl"}]
# Server-side only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
MON_FEATURED_PARTNERS=

# ─── Sponsor Slot ────────────────────────────────────────────────────────────
# One labeled 'Sponsored' slot. If NEXT_PUBLIC_SPONSOR_HTML is set, it renders
# as a plain-text message (no HTML parsing). If unset, falls back to the
# backfill URL link. If both are unset, renders nothing.
# Example: NEXT_PUBLIC_SPONSOR_HTML=Sponsored by LegalShield — plans from $24.95/mo
# Example: NEXT_PUBLIC_SPONSOR_BACKFILL_URL=https://tracking.sponsor.com/legal
NEXT_PUBLIC_SPONSOR_HTML=
NEXT_PUBLIC_SPONSOR_BACKFILL_URL=

# ─── Email Capture ───────────────────────────────────────────────────────────
# Valid values: on | off   Default: off (renders nothing when unset or "off").
# Uses the existing /api/subscribe route — no extra backend required.
# CAN-SPAM (15 U.S.C. § 7704) requires a physical postal address on any form
# that collects email addresses for future messages. The email-capture block
# renders NOTHING unless BOTH NEXT_PUBLIC_EMAIL_CAPTURE=on AND
# NEXT_PUBLIC_POSTAL_ADDRESS are set — do not enable one without the other.
NEXT_PUBLIC_EMAIL_CAPTURE=

# Physical postal address shown on the email-capture form (CAN-SPAM requirement).
# Example: NEXT_PUBLIC_POSTAL_ADDRESS=LegalCostCalc, 123 Main St Suite 100, Wilmington, DE 19801
NEXT_PUBLIC_POSTAL_ADDRESS=

# ─── "Email my results" (T17 — transactional, distinct from Email Capture above) ──
# Renders the "Email my results" form ONLY when ALL THREE are set:
#  - EMAIL_CAPTURE_ENDPOINT (server-only, never NEXT_PUBLIC_) — your ESP's API
#    URL (e.g. MailerLite/Buttondown). The route forwards { email, calc_type,
#    share_url, marketing_opt_in } here; nothing is stored in this app's DB.
#  - NEXT_PUBLIC_EMAIL_CAPTURE_ENABLED=1 — client-side render gate.
#  - NEXT_PUBLIC_POSTAL_ADDRESS (above) — the SAME CAN-SPAM gate reused from
#    the existing Email Capture block; any commercial email-collection form
#    must display a physical postal address.
# The email sent is TRANSACTIONAL ONLY (result permalink, zero promo) —
# CAN-SPAM/CASL transactional exemption. A separate, always-unchecked
# marketing opt-in checkbox is the only path to future promotional email.
EMAIL_CAPTURE_ENDPOINT=
NEXT_PUBLIC_EMAIL_CAPTURE_ENABLED=

# Optional bearer token forwarded to EMAIL_CAPTURE_ENDPOINT. Server-only.
EMAIL_CAPTURE_API_KEY=

# ─── Auto-affiliate (uncontracted links) ─────────────────────────────────────
# Provider ID for links that don't have a direct affiliate deal.
# Example: NEXT_PUBLIC_AUTOAFFILIATE=sovrn
# Example: NEXT_PUBLIC_AUTOAFFILIATE=skimlinks:12345
NEXT_PUBLIC_AUTOAFFILIATE=

# ─── Direct Affiliate Partner URLs ───────────────────────────────────────────
# Set the corresponding env var to your HTTPS tracking URL from the partner's
# affiliate dashboard (Impact / CJ / ShareASale). Leave unset to suppress the
# partner link entirely.
# Example: NEXT_PUBLIC_AFFILIATE_LEGALZOOM_URL=https://tracking.impact.com/your-id/legalzoom
NEXT_PUBLIC_AFFILIATE_LEGALZOOM_URL=
NEXT_PUBLIC_AFFILIATE_ROCKETLAWYER_URL=
NEXT_PUBLIC_AFFILIATE_LEGALMATCH_URL=
NEXT_PUBLIC_AFFILIATE_AVVO_URL=
NEXT_PUBLIC_AFFILIATE_NOLO_URL=
NEXT_PUBLIC_AFFILIATE_LAWDEPOT_URL=
