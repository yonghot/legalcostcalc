# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google AdSense (optional) — set after your site is APPROVED in AdSense.
# Format: ca-pub-XXXXXXXXXXXXXXXX  (leave unset to disable ads entirely)
# When set: loads the AdSense script, serves /ads.txt, and widens the CSP for Google ad domains.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Privacy-friendly analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=legalcostcalc.com
